1/subscriptions","organizations_url":"https://api.github.com/users/vabene1111/orgs","repos_url":"https://api.github.com/users/vabene1111/repos","events_url":"https://api.github.com/users/vabene1111/events{/privacy}","received_events_url":"https://api.github.com/users/vabene1111/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2021-10-02T18:46:52Z","updated_at":"2021-10-02T18:46:52Z","body":"No you want to work on a frontend component, those are either HTML or vue files. The particular one you are looking for is  Recipe View.vue\n\nIf you are not sure how to implement this into the application you could just write the Javascript function and PR it to utils.js and I can implement it into the frontend later","author_association":"COLLABORATOR","pin":null,"reactions":{"url":"https://api.github.com/repos/TandoorRecipes/recipes/issues/comments/932802160/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/TandoorRecipes/recipes/issues/comments/932892624","html_url":"https://github.com/TandoorRecipes/recipes/issues/382#issuecomment-932892624","issue_url":"https://api.github.com/repos/TandoorRecipes/recipes/issues/382","id":932892624,"node_id":"IC_kwDODTSHxc43ms_Q","user":{"login":"MdAsimKhan","id":51525305,"node_id":"MDQ6VXNlcjUxNTI1MzA1","avatar_url":"https://avatars.githubusercontent.com/u/51525305?v=4","gravatar_id":"","url":"https://api.github.com/users/MdAsimKhan","html_url":"https://github.com/MdAsimKhan","followers_url":"https://api.github.com/users/MdAsimKhan/followers","following_url":"https://api.github.com/users/MdAsimKhan/following{/other_user}","gists_url":"https://api.github.com/users/MdAsimKhan/gists{/gist_id}","starred_url":"https://api.github.com/users/MdAsimKhan/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MdAsimKhan/subscriptions","organizations_url":"https://api.github.com/users/MdAsimKhan/orgs","repos_url":"https://api.github.com/users/MdAsimKhan/repos","events_url":"https://api.github.com/users/MdAsimKhan/events{/privacy}","received_events_url":"https://api.github.com/users/MdAsimKhan/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2021-10-03T09:00:21Z","updated_at":"2021-10-03T12:38:53Z","body":"`function timeConvert(n){\r\n    var num = n;\r\n    if (num <= 90) {\r\n        return num + \" min\";\r\n    }\r\n    else {\r\n        var hours = num / 60;\r\n        var rhours = Math.floor(hours);\r\n        var mins = (hours - rhours) * 60;\r\n        var rmins = Math.round(mins);\r\n        if (mins == 0) {\r\n            return rhours + \" h\";\r\n        }\r\n        else {\r\n            return rhours + \" h \" + rmins + \" min\";\r\n        }\r\n    }\r\n}`\r\n\r\nSomething like this? @vabene1111 ","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/TandoorRecipes/recipes/issues/comments/932892624/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/TandoorRecipes/recipes/issues/comments/933210764","html_url":"https://github.com/TandoorRecipes/recipes/issues/382#issuecomment-933210764","issue_url":"https://api.github.com/repos/TandoorRecipes/recipes/issues/382","id":933210764,"node_id":"IC_kwDODTSHxc43n6qM","user":{"login":"vabene1111","id":6819595,"node_id":"MDQ6VXNlcjY4MTk1OTU=","avatar_url":"https://avatars.githubusercontent.com/u/6819595?v=4","gravatar_id":"","url":"https://api.github.com/users/vabene1111","html_url":"https://github.com/vabene1111","followers_url":"https://api.github.com/users/vabene1111/followers","following_url":"https://api.github.com/users/vabene1111/following{/other_user}","gists_url":"https://api.github.com/users/vabene1111/gists{/gist_id}","starred_url":"https://api.github.com/users/vabene1111/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/vabene1111/subscriptions","organizations_url":"https://api.github.com/users/vabene1111/orgs","repos_url":"https://api.github.com/users/vabene1111/repos","events_url":"https://api.github.com/users/vabene1111/events{/privacy}","received_events_url":"https://api.github.com/users/vabene1111/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2021-10-04T07:16:46Z","updated_at":"2021-10-04T07:16:46Z","body":"@wisdomkhan i appreciate you trying to help in getting this project forward and i am willing to invest some time to help new contributers forward but sadly i have very limited time right now and working like this (and the last PR) takes substantially more time for me than simply fixing the issue myself. I am sorry, i would love to have the time to properly go trough this with you but i simply cant right now. \r\n\r\nAs a general advice for your contributions try to understand the issue from what is already written there and if you have questions formulate those precisely. If someone leaves an easy issue open its likely due to a lack of time or priority and most maintainers will not have the time to guide you trough this step by step. If you decide to implement something on an issue like this one and dont understand how to best do it i peronally think the best way is to document some clear results. In a case like this particular one that would mean post the code commented, properly formatted as a code block\r\n\r\n```javascript\r\nfunction timeConvert(n){ \r\nvar num = n;\r\n if (num <= 90) { \r\nreturn num + \" min\";\r\n } else {\r\n var hours = num / 60; \r\nvar rhours = Math.floor(hours); \r\nvar mins = (hours - rhours) * 60; \r\nvar rmins = Math.round(mins); \r\nif (mins == 0) { \r\nreturn rhours + \" h\"; \r\n} else { \r\nreturn rhours + \" h \" + rmins + \" min\";\r\n } \r\n} \r\n}\r\n```\r\nThen it is important clearly communicate what your changes do. If its a UI change make sure to include a screenshot, if its code like this write all relevant input cases for the function (e.g. entering 0 minutes, 1 minute, 30 minutes, 70 minutes, and likely something with more than 24 hours) and show that it does for each case what it is supposed to do. This way the maintainer does not need to go into a javascript console themself and test out all those cases and can quickly see that the suggested change is working as intended. Optionally many maintainers expect that you quickly elaborate on considered alternatives and a small explanaition on why you decided to implement something the way you did (probably not on something as simple as this but if you start doing bigger contributions)\r\n\r\nI will try to update the contribution guide so its easier to understand where you can get started and where you need to look depending on what you want to edit. Again, i am sorry for not having the time to help you further on this particular contribution, from a first look your code looks like it does what it is supposed to do so i might be able to use it when fixing this issue altough there might be some need for localization. Hope this post helps to guide your future contributions, please dont feel demotivated by this but on small projects like this with only a single maintainer working on merging PRs there is often simply not enough time to properly help beginners getting started. ","author_association":"COLLABORATOR","pin":null,"reactions":{"url":"https://api.github.com/repos/TandoorRecipes/recipes/issues/comments/933210764/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/TandoorRecipes/recipes/issues/comments/933214700","html_url":"https://github.com/TandoorRecipes/recipes/issues/382#issuecomment-933214700","issue_url":"https://api.github.com/repos/TandoorRecipes/recipes/issues/382","id":933214700,"node_id":"IC_kwDODTSHxc43n7ns","user":{"login":"MdAsimKhan","id":51525305,"node_id":"MDQ6VXNlcjUxNTI1MzA1","avatar_url":"https://avatars.githubusercontent.com/u/51525305?v=4","gravatar_id":"","url":"https://api.github.com/users/MdAsimKhan","html_url":"https://github.com/MdAsimKhan","followers_url":"https://api.github.com/users/MdAsimKhan/followers","following_url":"https://api.github.com/users/MdAsimKhan/following{/other_user}","gists_url":"https://api.github.com/users/MdAsimKhan/gists{/gist_id}","starred_url":"https://api.github.com/users/MdAsimKhan/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MdAsimKhan/subscriptions","organizations_url":"https://api.github.com/users/MdAsimKhan/orgs","repos_url":"https://api.github.com/users/MdAsimKhan/repos","events_url":"https://api.github.com/users/MdAsimKhan/events{/privacy}","received_events_url":"https://api.github.com/users/MdAsimKhan/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2021-10-04T07:23:07Z","updated_at":"2021-10-04T07:23:07Z","body":"I understand it perfectly sir. No need to be sorry. I'd keep your guidelines in mind for future contributions. Thank you so much for your guidance and time. All the best! 😄","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/TandoorRecipes/recipes/issues/comments/933214700/reactions","total_count":2,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":2,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/TandoorRecipes/recipes/issues/comments/1003776403","html_url":"https://github.com/TandoorRecipes/recipes/issues/382#issuecomment-1003776403","issue_url":"https://api.github.com/repos/TandoorRecipes/recipes/issues/382","id":1003776403,"node_id":"IC_kwDODTSHxc471GmT","user":{"login":"dr-froehlich","id":45740834,"node_id":"MDQ6VXNlcjQ1NzQwODM0","avatar_url":"https://avatars.githubusercontent.com/u/45740834?v=4","gravatar_id":"","url":"https://api.github.com/users/dr-froehlich","html_url":"https://github.com/dr-froehlich","followers_url":"https://api.github.com/users/dr-froehlich/followers","following_url":"https://api.github.com/users/dr-froehlich/following{/other_user}","gists_url":"https://api.github.com/users/dr-froehlich/gists{/gist_id}","starred_url":"https://api.github.com/users/dr-froehlich/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dr-froehlich/subscriptions","organizations_url":"https://api.github.com/users/dr-froehlich/orgs","repos_url":"https://api.github.com/users/dr-froehlich/repos","events_url":"https://api.github.com/users/dr-froehlich/events{/privacy}","received_events_url":"https://api.github.com/users/dr-froehlich/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-01-02T21:16:12Z","updated_at":"2022-01-03T06:44:12Z","body":"**Is your feature request related to a problem? Please describe.**\r\n[Sometimes you have a recipe with ridiculous amounts of time going into it, e.g. a Baguette recipe with 72h proofing time.] For bread baking e.g. on Saturday preparation steps may have to be performed on Thursday and Friday, adding the days would add clarity.\r\n\r\n**Describe the solution you'd like**\r\nIn addition to adjusting the time display format it would be helpful to also display the day of the week for each of the involved steps. Example: 17:45 Thursday instead of just 17:45. \r\n\r\n**Describe alternatives you've considered**\r\n\r\n- Ideally days are displayed as soon as beginning of step 1 and ending of the last step are not on the same day.\r\n- Instead of showing the weekday one could add e.g. \"+1d\" with an enumeration for every 24h that have lapsed since the start time of the recipe. Example: if 17:45 is the start time, next morning 6:45 would show as 6:45 but that day 18:00 would show as \"18:00 (+1d)\" This would work without localization and possibly be simple solution. This would make the recipe independet from the calendar.\r\n\r\nJust learned of this very cool project, thanks for the great work!","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/TandoorRecipes/recipes/issues/comments/1003776403/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/TandoorRecipes/recipes/issues/comments/1004587539","html_url":"https://github.com/TandoorRecipes/recipes/issues/382#issuecomment-1004587539","issue_url":"https://api.github.com/repos/TandoorRecipes/recipes/issues/382","id":1004587539,"node_id":"IC_kwDODTSHxc474MoT","user":{"login":"vabene1111","id":6819595,"node_id":"MDQ6VXNlcjY4MTk1OTU=","avatar_url":"https://avatars.githubusercontent.com/u/6819595?v=4","gravatar_id":"","url":"https://api.github.com/users/vabene1111","html_url":"https://github.com/vabene1111","followers_url":"https://api.github.com/users/vabene1111/followers","following_url":"https://api.github.com/users/vabene1111/following{/other_user}","gists_url":"https://api.github.com/users/vabene1111/gists{/gist_id}","starred_url":"https://api.github.com/users/vabene1111/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/vabene1111/subscriptions","organizations_url":"https://api.github.com/users/vabene1111/orgs","repos_url":"https://api.github.com/users/vabene1111/repos","events_url":"https://api.github.com/users/vabene1111/events{/privacy}","received_events_url":"https://api.github.com/users/vabene1111/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-01-04T07:42:27Z","updated_at":"2022-01-04T07:42:27Z","body":"yes this makes sense. I explicitly added the time feature for bread baking and actually showing the day not just the time really makes sense","author_association":"COLLABORATOR","pin":null,"reactions":{"url":"https://api.github.com/repos/TandoorRecipes/recipes/issues/comments/1004587539/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/TandoorRecipes/recipes/issues/comments/2948726444","html_url":"https://github.com/TandoorRecipes/recipes/issues/382#issuecomment-2948726444","issue_url":"https://api.github.com/repos/TandoorRecipes/recipes/issues/382","id":2948726444,"node_id":"IC_kwDODTSHxc6vwf6s","user":{"login":"mkieledunsche","id":83220538,"node_id":"MDQ6VXNlcjgzMjIwNTM4","avatar_url":"https://avatars.githubusercontent.com/u/83220538?v=4","gravatar_id":"","url":"https://api.github.com/users/mkieledunsche","html_url":"https://github.com/mkieledunsche","followers_url":"https://api.github.com/users/mkieledunsche/followers","following_url":"https://api.github.com/users/mkieledunsche/following{/other_user}","gists_url":"https://api.github.com/users/mkieledunsche/gists{/gist_id}","starred_url":"https://api.github.com/users/mkieledunsche/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mkieledunsche/subscriptions","organizations_url":"https://api.github.com/users/mkieledunsche/orgs","repos_url":"https://api.github.com/users/mkieledunsche/repos","events_url":"https://api.github.com/users/mkieledunsche/events{/privacy}","received_events_url":"https://api.github.com/users/mkieledunsche/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-06T09:58:54Z","updated_at":"2025-06-06T09:58:54Z","body":"Just looked into the code (Tandor2.0.0-alpha-5) and saw:\n[✓] `function calculateHourMinuteSplit(amount)` is implemented in [utils.js](https://github.com/TandoorRecipes/recipes/blob/2.0.0-alpha-5/vue/src/utils/utils.js)\n[✓] import of calculateHourMinuteSplit done in [RecipeViewComponent.vue#L170][(https://github.com/TandoorRecipes/recipes/blob/2.0.0-alpha-5/vue/src/components/RecipeViewComponent.vue](https://github.com/TandoorRecipes/recipes/blob/2.0.0-alpha-5/vue/src/components/RecipeViewComponent.vue#L170))\n[✓] workingtime and waiting time are computed using calculateHourMinuteSplit() in [RecipeViewComponent.vue#L170][(https://github.com/TandoorRecipes/recipes/blob/2.0.0-alpha-5/vue/src/components/RecipeViewComponent.vue](https://github.com/TandoorRecipes/recipes/blob/2.0.0-alpha-5/vue/src/components/RecipeViewComponent.vue#L170)\n\nRecipe view though does not show the hour-minute-splite in the recipe view (screenshot below)\nLet me know if there is anyting I can do to get this topic moved towards closure.\n\n![Image](https://github.com/user-attachments/assets/0f604a91-7486-4676-bdd4-7db398cc6858)\n","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/TandoorRecipes/recipes/issues/comments/2948726444/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/TandoorRecipes/recipes/issues/comments/2948891618","html_url":"https://github.com/TandoorRecipes/recipes/issues/382#issuecomment-2948891618","issue_url":"https://api.github.com/repos/TandoorRecipes/recipes/issues/382","id":2948891618,"node_id":"IC_kwDODTSHxc6vxIPi","user":{"login":"mkieledunsche","id":83220538,"node_id":"MDQ6VXNlcjgzMjIwNTM4","avatar_url":"https://avatars.githubusercontent.com/u/83220538?v=4","gravatar_id":"","url":"https://api.github.com/users/mkieledunsche","html_url":"https://github.com/mkieledunsche","followers_url":"https://api.github.com/users/mkieledunsche/followers","following_url":"https://api.github.com/users/mkieledunsche/following{/other_user}","gists_url":"https://api.github.com/users/mkieledunsche/gists{/gist_id}","starred_url":"https://api.github.com/users/mkieledunsche/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mkieledunsche/subscriptions","organizations_url":"https://api.github.com/users/mkieledunsche/orgs","repos_url":"https://api.github.com/users/mkieledunsche/repos","events_url":"https://api.github.com/users/mkieledunsche/events{/privacy}","received_events_url":"https://api.github.com/users/mkieledunsche/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-06T11:00:24Z","updated_at":"2025-06-06T11:00:24Z","body":"Regarding the topic mentioned by @dr-froehlich would suggest to change [timer.vue](https://github.com/TandoorRecipes/recipes/blob/2.0.0-alpha-5/vue3/src/components/display/Timer.vue)\n\nWould suggest to add a method to the Timer.vue or in case there's a possiblity seen for reuse to add as export funcition to utils.js\n\n```\nmethods: {\n\tformatFinishTime(durationSeconds) {\n\t\tconst now = DateTime.now();\n\t\tconst target = now.plus({ seconds: durationSeconds });\n\n\t\tlet timeString = target.toLocaleString(DateTime.TIME_SIMPLE);\n\n\t\tconst daysDifference = Math.floor(\n\t\t\ttarget.startOf('day').diff(now.startOf('day'), 'days').days\n\t\t);\n\t\t\n\t\tif (daysDifference >= 1) {\n\t\t\ttimeString += ` +${daysDifference}d`;\n\t\t}\n\n\treturn timeString;\n\t}\n}\n```\n\nreplace line 5 `{{$t('FinishedAt')}} {{ DateTime.now().plus({'seconds': durationSeconds}).toLocaleString(DateTime.TIME_SIMPLE) }}`\nwith `{{$t('FinishedAt')}} {{ formatFinishTime(durationSeconds) }}`\n\nDone some testing for debugging and looks fine:\n![Image](https://github.com/user-attachments/assets/c2ec023e-01c2-47da-919a-198109e53f6c)\n\n@vabene1111 let me know if you're ok for me to try go for changing the code of the timer.vue or add it to utils.js","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/TandoorRecipes/recipes/issues/comments/2948891618/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/TandoorRecipes/recipes/issues/comments/2949048446","html_url":"https://github.com/TandoorRecipes/recipes/issues/382#issuecomment-2949048446","issue_url":"https://api.github.com/repos/TandoorRecipes/recipes/issues/382","id":2949048446,"node_id":"IC_kwDODTSHxc6vxuh-","user":{"login":"vabene1111","id":6819595,"node_id":"MDQ6VXNlcjY4MTk1OTU=","avatar_url":"https://avatars.githubusercontent.com/u/6819595?v=4","gravatar_id":"","url":"https://api.github.com/users/vabene1111","html_url":"https://github.com/vabene1111","followers_url":"https://api.github.com/users/vabene1111/followers","following_url":"https://api.github.com/users/vabene1111/following{/other_user}","gists_url":"https://api.github.com/users/vabene1111/gists{/gist_id}","starred_url":"https://api.github.com/users/vabene1111/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/vabene1111/subscriptions","organizations_url":"https://api.github.com/users/vabene1111/orgs","repos_url":"https://api.github.com/users/vabene1111/repos","events_url":"https://api.github.com/users/vabene1111/events{/privacy}","received_events_url":"https://api.github.com/users/vabene1111/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-06T12:06:48Z","updated_at":"2025-06-06T12:06:48Z","body":"looks good to me, feel free to implement something like that. Please try to keep it as simple as possible and make sure its localized. \n\nAlso do not use the `vue` folder its for tandoor 1 and will be deleted, all new stuff is in the `vue3` folder. \n\nThanks for looking into this. ","author_association":"COLLABORATOR","pin":null,"reactions":{"url":"https://api.github.com/repos/TandoorRecipes/recipes/issues/comments/2949048446/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/TandoorRecipes/recipes/issues/comments/5269442017","html_url":"https://github.com/TandoorRecipes/recipes/issues/382#issuecomment-5269442017","issue_url":"https://api.github.com/repos/TandoorRecipes/recipes/issues/382","id":5269442017,"node_id":"IC_kwDODTSHxc8AAAABOhVN4Q","user":{"login":"dr-froehlich","id":45740834,"node_id":"MDQ6VXNlcjQ1NzQwODM0","avatar_url":"https://avatars.githubusercontent.com/u/45740834?v=4","gravatar_id":"","url":"https://api.github.com/users/dr-froehlich","html_url":"https://github.com/dr-froehlich","followers_url":"https://api.github.com/users/dr-froehlich/followers","following_url":"https://api.github.com/users/dr-froehlich/following{/other_user}","gists_url":"https://api.github.com/users/dr-froehlich/gists{/gist_id}","starred_url":"https://api.github.com/users/dr-froehlich/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dr-froehlich/subscriptions","organizations_url":"https://api.github.com/users/dr-froehlich/orgs","repos_url":"https://api.github.com/users/dr-froehlich/repos","events_url":"https://api.github.com/users/dr-froehlich/events{/privacy}","received_events_url":"https://api.github.com/users/dr-froehlich/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-12T16:18:25Z","updated_at":"2026-08-12T16:18:25Z","body":"Opened #4785 for this.\n\nRecipe and step times render as `1 h 30 min` above the hour and `72 h` for a long proof\ninstead of `4320 min` — at both recipe detail layouts, the recipe card chip (which\npreviously showed a bare number with no unit at all) and the step timer button. No day\nrollover, matching the table earlier in this thread. It sits behind a per-user preference\nthat defaults off, so nothing changes for existing users unless they turn it on.\n\nOne thing worth noting for anyone arriving here from a search: #3751 and #3778 are linked\nabove and look like they closed this, but what they add is the localized `+2 Days` suffix on\nthe running step timer's \"Finished at\" line. That is a different surface, and it works — the\nrecipe page itself still shows raw minutes today.\n\nHappy to reshape the PR: the test tooling is a separate commit that can be dropped, and the\ndefault is a one-line change if on-by-default would be preferred.\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/TandoorRecipes/recipes/issues/comments/5269442017/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/TandoorRecipes/recipes/issues/comments/5276589592","html_url":"https://github.com/TandoorRecipes/recipes/issues/382#issuecomment-5276589592","issue_url":"https://api.github.com/repos/TandoorRecipes/recipes/issues/382","id":5276589592,"node_id":"IC_kwDODTSHxc8AAAABOoJeGA","user":{"login":"dr-froehlich","id":45740834,"node_id":"MDQ6VXNlcjQ1NzQwODM0","avatar_url":"https://avatars.githubusercontent.com/u/45740834?v=4","gravatar_id":"","url":"https://api.github.com/users/dr-froehlich","html_url":"https://github.com/dr-froehlich","followers_url":"https://api.github.com/users/dr-froehlich/followers","following_url":"https://api.github.com/users/dr-froehlich/following{/other_user}","gists_url":"https://api.github.com/users/dr-froehlich/gists{/gist_id}","starred_url":"https://api.github.com/users/dr-froehlich/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dr-froehlich/subscriptions","organizations_url":"https://api.github.com/users/dr-froehlich/orgs","repos_url":"https://api.github.com/users/dr-froehlich/repos","events_url":"https://api.github.com/users/dr-froehlich/events{/privacy}","received_events_url":"https://api.github.com/users/dr-froehlich/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-13T06:05:53Z","updated_at":"2026-08-13T06:05:53Z","body":"The other half of my original ask here — the weekday on each step — is not in #4785 by design, since it needs an anchor to a wall clock that the recipe page doesn't have today. I've proposed it separately on #1882 (Time Rework), where it fits the \"multi day recipes\" item: https://github.com/TandoorRecipes/recipes/issues/1882#issuecomment-5276392328\n\nBriefly: you give the recipe a finish time and it back-chains a start time per step, so a bake due Sunday morning tells you when to mix the levain on Thursday. It ended up using both alternatives I floated in 2022 — weekday names near in, and the explicit `(−9 d)` offset once the span passes a week and a bare weekday stops being unambiguous. Frontend only, and it picks the finish time up from the meal planner automatically.\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/TandoorRecipes/recipes/issues/comments/5276589592/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/TandoorRecipes/recipes/issues/comments/5569802292","html_url":"https://github.com/TandoorRecipes/recipes/issues/382#issuecomment-5569802292","issue_url":"https://api.github.com/repos/TandoorRecipes/recipes/issues/382","id":5569802292,"node_id":"IC_kwDODTSHxc8AAAABS_xwNA","user":{"login":"dr-froehlich","id":45740834,"node_id":"MDQ6VXNlcjQ1NzQwODM0","avatar_url":"https://avatars.githubusercontent.com/u/45740834?v=4","gravatar_id":"","url":"https://api.github.com/users/dr-froehlich","html_url":"https://github.com/dr-froehlich","followers_url":"https://api.github.com/users/dr-froehlich/followers","following_url":"https://api.github.com/users/dr-froehlich/following{/other_user}","gists_url":"https://api.github.com/users/dr-froehlich/gists{/gist_id}","starred_url":"https://api.github.com/users/dr-froehlich/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dr-froehlich/subscriptions","organizations_url":"https://api.github.com/users/dr-froehlich/orgs","repos_url":"https://api.github.com/users/dr-froehlich/repos","events_url":"https://api.github.com/users/dr-froehlich/events{/privacy}","received_events_url":"https://api.github.com/users/dr-froehlich/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-07T11:15:53Z","updated_at":"2026-09-07T11:15:53Z","body":"Small update on this: #4785 was closed in favour of a simpler implementation without the user\npreference, which is now open as #4810 — recipe and step times rendered as hours\nand minutes unconditionally, matching the table in the original request here.\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/TandoorRecipes/recipes/issues/comments/5569802292/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]