# Deploy target for the fork — copy to deploy/target.env and fill in.
#
#   cp deploy/target.env.example deploy/target.env
#
# deploy/target.env is gitignored and must stay that way. REQ-002 Decision 3: the fork
# repository is public so that individual changes stay offerable upstream, which means no
# household hostname, internal IP, public recipe domain, or compose path is ever committed.
# This example file names the keys; only your working copy holds the values.

# ---- required -------------------------------------------------------------------------

# ssh destination for the household host, exactly as you would type it after `ssh`.
# A ~/.ssh/config alias is the tidiest form and keeps the real hostname out of this file.
DEPLOY_SSH_HOST=

# Absolute path on the host of the directory holding docker-compose.yml and .env.
DEPLOY_COMPOSE_DIR=

# Public base URL of the deployment, no trailing slash. Used only to print the /system/
# link at the end of a deploy — the page AC4's sign-off is read from.
DEPLOY_PUBLIC_URL=

# ---- optional (defaults shown) ----------------------------------------------------------

# The published fork image. Override only if you renamed the ghcr package.
#DEPLOY_IMAGE=ghcr.io/dr-froehlich/recipes

# Compose service names, as they appear in the host's docker-compose.yml. The defaults
# match upstream's reference stack (docs/install/docker/*/docker-compose.yml).
#DEPLOY_DB_SERVICE=db_recipes
#DEPLOY_APP_SERVICE=web_recipes

# Where dumps are written on the workstation. Kept out of the repo tree by .gitignore;
# point it at an encrypted volume if you would rather household data not sit here.
#DEPLOY_DUMP_DIR=deploy/dumps
